{
  "name": "chrome-lens-ts",
  "version": "0.1.0",
  "description": "Chrome DevTools MCP Server - Direct access to Chrome's DevTools Protocol for granular real-time debugging",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node server.ts",
    "test": "jest",
    "lint": "eslint *.ts tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "keywords": ["mcp", "chrome", "devtools", "debugging", "typescript"],
  "author": "Chrome Lens MCP",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "chrome-remote-interface": "^0.33.2",
    "ws": "^8.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@types/ws": "^8.5.13"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!dist/**",
      "!node_modules/**",
      "!coverage/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "globals": {
      "ts-jest": {
        "useESM": true,
        "tsconfig": {
          "module": "ES2022",
          "target": "ES2022"
        }
      }
    }
  }
}