{
  "name": "chrome-lens-ts",
  "version": "0.1.0",
  "description": "Chrome DevTools MCP Server - Direct access to Chrome's DevTools Protocol for granular real-time debugging",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.build.json --removeComments",
    "dev": "ts-node server.ts",
    "test": "jest",
    "lint": "eslint *.ts tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "start": "node mcp-server.js"
  },
  "keywords": [
    "mcp",
    "chrome",
    "devtools",
    "debugging",
    "typescript"
  ],
  "author": "Chrome Lens MCP",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "chrome-remote-interface": "^0.33.2",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.31",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
